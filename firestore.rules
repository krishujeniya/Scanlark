rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function ownsHistory(userEmail) {
      return request.auth != null
        && request.auth.token.email != null
        && request.auth.token.email == userEmail;
    }

    match /users/{userEmail}/history/{entryId} {
      allow get, list: if ownsHistory(userEmail);
      allow create: if ownsHistory(userEmail)
        && request.resource.data.keys().hasOnly(['text', 'timestamp'])
        && request.resource.data.keys().hasAll(['text', 'timestamp'])
        && request.resource.data.text is string
        && request.resource.data.timestamp == request.time;
      allow update, delete: if false;
    }
  }
}
